#pragma once

#include <string>

// For MFEM_USE_MPI (build flavour in the banner).
#include "mfem.hpp"

namespace build_info {

constexpr const char* kVersion = "@PROJECT_VERSION@";
constexpr const char* kCommit = "@GIT_COMMIT@@GIT_DIRTY@";

// __DATE__/__TIME__ record when the including translation unit, main.cpp, was
// compiled. Changes to the library alone relink the executable without
// recompiling main.cpp; the commit and its -dirty marker identify the sources.
constexpr const char* kBuildDate = __DATE__ " " __TIME__;

inline std::string Describe() {
	return std::string("noumena ") + kVersion +
		" (commit " + kCommit + ", built " + kBuildDate +
#ifdef MFEM_USE_MPI
		", MPI/HYPRE"
#else
		", serial"
#endif
		+ ")";
}

} // namespace build_info
