# ------------------------------------------------------------------------------
# Build Systems (CMake)
# ------------------------------------------------------------------------------
/build/
/bin/
/lib/
# Visual Studio CMakePresets output (out/build/<preset>, out/install/<preset>)
/out/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
*.cmake
!MFEMConfig.cmake
!/cmake/*.cmake

# ------------------------------------------------------------------------------
# C++ Compiled Objects & Binaries
# ------------------------------------------------------------------------------
*.o
*.obj
*.so
*.dylib
*.a
*.lib
*.exe
*.out
*.app

# ------------------------------------------------------------------------------
# MFEM & Simulation Artifacts
# ------------------------------------------------------------------------------
# Prevent committing heavy solution vectors or generated meshes
*.gf
*.saved
*.vtk
*.vtu
*.pvd

# MFEM often outputs directories for parallel runs (e.g., 'ParaView', 'Vis')
ParaView/
Vis/
Example*_*/

# Ignore standard output logs (unless you specifically want to save them)
*.log

# ------------------------------------------------------------------------------
# IDE & Editor Configuration
# ------------------------------------------------------------------------------
# VS Code
.vscode/
*.code-workspace

# CLion / IntelliJ
.idea/
cmake-build-*/

# Visual Studio
.vs/
*.sln
*.vcxproj
*.vcxproj.user

# Vim/Emacs/Mac
*.swp
*~
.DS_Store

# ------------------------------------------------------------------------------
# Documentation / Reports
# ------------------------------------------------------------------------------
# If you generate LaTeX reports automatically, ignore the build clutter
*.aux
*.fdb_latexmk
*.fls
*.synctex.gz
*.toc
test/electrostatic_test.msh
lib64
pyvenv.cfg
results_magnetostatic/*
results_mqs/*
examples/simple_capacitor/results_electrostatic/*
/examples/simple_capacitor/results_electrostatic_Bottom Plate/Cycle000000
/examples/simple_capacitor/results_electrostatic_Top Plate/Cycle000000
/examples/simple_capacitor/results_electrostatic_Top Plate/Cycle000000/data.pvtu
/results_electrostatics_Bottom Plate/Cycle000000
/results_electrostatics_Top Plate/Cycle000000
/build-*/

# Python bytecode caches (examples/*/compare.py and similar scripts)
__pycache__/

# The TEAM 15 and 21a meshes are generated with Gmsh (see their READMEs)
examples/team21a/*.msh
examples/team21a/results-*/
examples/team15/*.msh
examples/team15/results-*/
